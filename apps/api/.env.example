# Copy to .env and fill in real values. Never commit the filled-in file.
# Variables marked REQUIRED are validated at startup by src/config/env.ts —
# the process exits immediately if any is missing.

PORT=4000
NODE_ENV=development

# REQUIRED — Supabase connection string (Project Settings -> Database -> URI)
DATABASE_URL="postgresql://postgres:<YOUR-PASSWORD>@db.<YOUR-PROJECT-REF>.supabase.co:5432/postgres"

# REQUIRED — generate your own, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=<generate-a-long-random-string>
JWT_REFRESH_SECRET=<generate-a-different-long-random-string>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Email — SMTP is REQUIRED (EMAIL_HOST, EMAIL_USER, EMAIL_PASSWORD).
# For Gmail, EMAIL_PASSWORD must be an App Password, not your account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=<your-smtp-user>
EMAIL_PASSWORD=<your-smtp-app-password>
EMAIL_FROM=NestOS <your-address@example.com>

# Optional — set to send via Resend instead of raw SMTP
RESEND_API_KEY=

# File storage
UPLOAD_DIR=uploads

# Must match the origin the web app runs on, or CORS will reject every request
FRONTEND_URL=http://localhost:3000
