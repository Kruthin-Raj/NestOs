# Copy this file to apps/api/.env and fill in your own values.
#
#   cp apps/api/.env.example apps/api/.env
#
# Never commit the filled-in .env, and never reuse someone else's credentials —
# get your own Supabase project and your own Gmail App Password. Anything marked
# REQUIRED is checked at startup by src/config/env.ts; the process exits and
# names the variable if it is missing.
#
# Once filled in:  cd apps/api && pnpm db:generate && pnpm db:push

PORT=4000
NODE_ENV=development

# REQUIRED — your own Supabase project.
# supabase.com -> New Project -> Project Settings -> Database -> Connection string (URI).
# Replace both placeholders below with the values from that page.
DATABASE_URL="postgresql://postgres:<YOUR-DB-PASSWORD>@db.<YOUR-PROJECT-REF>.supabase.co:5432/postgres"

# REQUIRED — sign the auth cookies. Generate two DIFFERENT random strings:
#   openssl rand -hex 32          (or any long random string)
JWT_ACCESS_SECRET=<generate-a-long-random-string>
JWT_REFRESH_SECRET=<generate-a-different-long-random-string>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# One-time codes: used to confirm an address at signup and to reset a password.
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# REQUIRED — EMAIL_HOST, EMAIL_USER, EMAIL_PASSWORD and EMAIL_FROM.
# Mail goes out over SMTP via nodemailer (src/config/mail.ts).
# For Gmail, EMAIL_PASSWORD must be an App Password (Google Account -> Security
# -> App passwords), not your normal account password.
# Define EMAIL_FROM exactly once — a duplicated key silently keeps the last one.
#
# If mail is not working, signup and password reset still print the code in the
# API terminal in development, so you are not blocked.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=<your-gmail-address>
EMAIL_PASSWORD=<your-16-character-app-password>
EMAIL_FROM=NestOS <your-gmail-address>

# Where uploaded documents are written, relative to apps/api.
UPLOAD_DIR=uploads

# Must exactly match the origin the web app runs on, or the browser drops every
# response and it looks like a broken login rather than a CORS problem.
FRONTEND_URL=http://localhost:3000
